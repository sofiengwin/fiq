<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "FIQ - Fun Interactive Quizzes" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="FIQ">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    
    <!-- Kahoot-style font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <style>
      body { font-family: 'Montserrat', sans-serif; }
    </style>
  </head>

  <body class="min-h-screen bg-gradient-to-b from-kahoot-purple-dark via-kahoot-purple to-kahoot-purple-dark">
    <!-- Navigation -->
    <nav class="bg-kahoot-purple-dark/80 backdrop-blur-md border-b border-kahoot-purple-light/30 sticky top-0 z-50">
      <div class="container mx-auto px-4 py-3 flex items-center justify-between">
        <%= link_to root_path, class: "flex items-center gap-2 text-2xl font-black text-white hover:scale-105 transition-transform" do %>
          <span class="text-3xl">🎯</span>
          <span class="bg-gradient-to-r from-white to-purple-200 bg-clip-text text-transparent">FIQ!</span>
        <% end %>
        <div class="flex items-center gap-3">
          <%= link_to quizzes_path, class: "text-white/90 hover:text-white font-semibold px-4 py-2 rounded-full hover:bg-white/10 transition" do %>
            Browse
          <% end %>
          <%= link_to new_quiz_path, class: "kahoot-btn bg-kahoot-green hover:bg-kahoot-green-light text-white px-5 py-2 rounded-full font-bold shadow-lg" do %>
            + Create
          <% end %>
        </div>
      </div>
    </nav>

    <!-- Flash Messages -->
    <% if notice %>
      <div class="container mx-auto px-4 mt-4">
        <div class="bg-kahoot-green/20 border-2 border-kahoot-green text-white px-6 py-4 rounded-2xl font-semibold animate-bounce-in">
          ✅ <%= notice %>
        </div>
      </div>
    <% end %>
    <% if alert %>
      <div class="container mx-auto px-4 mt-4">
        <div class="bg-kahoot-red/20 border-2 border-kahoot-red text-white px-6 py-4 rounded-2xl font-semibold animate-bounce-in">
          ⚠️ <%= alert %>
        </div>
      </div>
    <% end %>

    <main class="container mx-auto px-4 py-8">
      <%= yield %>
    </main>
    
    <!-- Footer -->
    <footer class="border-t border-kahoot-purple-light/20 py-6 mt-auto">
      <div class="container mx-auto px-4 text-center text-white/60 text-sm">
        <p>🎮 FIQ - Making learning fun! Built with ❤️</p>
      </div>
    </footer>
  </body>
</html>
