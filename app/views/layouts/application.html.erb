<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "FIQ - Fun Interactive Quizzes" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="FIQ">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Only load Tailwind CSS, not Active Admin CSS %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gradient-to-br from-purple-900 via-indigo-900 to-purple-800">
    <!-- Navigation -->
    <nav class="bg-purple-950/50 backdrop-blur-sm border-b border-purple-700/50">
      <div class="container mx-auto px-4 py-4 flex items-center justify-between">
        <%= link_to root_path, class: "text-2xl font-bold text-white hover:text-purple-300 transition" do %>
          🎮 FIQ
        <% end %>
        <div class="flex items-center gap-4">
          <%= link_to "⚡ Quick Play", play_path, class: "bg-green-600 hover:bg-green-500 text-white px-4 py-2 rounded-lg font-medium transition" %>
          <%= link_to "Browse Quizzes", quizzes_path, class: "text-purple-200 hover:text-white transition" %>
          <%= link_to "Create Quiz", new_quiz_path, class: "bg-purple-600 hover:bg-purple-500 text-white px-4 py-2 rounded-lg font-medium transition" %>
        </div>
      </div>
    </nav>

    <!-- Flash Messages -->
    <% if notice %>
      <div class="container mx-auto px-4 mt-4">
        <div class="bg-green-500/20 border border-green-500/50 text-green-200 px-4 py-3 rounded-lg">
          <%= notice %>
        </div>
      </div>
    <% end %>
    <% if alert %>
      <div class="container mx-auto px-4 mt-4">
        <div class="bg-red-500/20 border border-red-500/50 text-red-200 px-4 py-3 rounded-lg">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <main class="container mx-auto px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
