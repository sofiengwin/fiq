<turbo-stream action="replace" target="question-frame">
  <template>
    <% if @attempt.completed? %>
      <%= render partial: "quiz_attempts/question_result", formats: [ :html ], locals: { response: @response, next_question: nil } %>
    <% else %>
      <%= render partial: "quiz_attempts/question_result", formats: [ :html ], locals: { response: @response, next_question: @attempt.current_question } %>
    <% end %>
  </template>
</turbo-stream>

<turbo-stream action="update" target="play-score">
  <template>
    Score: <%= @attempt.total_score %>
  </template>
</turbo-stream>

<turbo-stream action="update" target="play-streak">
  <template>
    <% if @attempt.streak.to_i > 0 %>🔥 <%= @attempt.streak %> streak<% end %>
  </template>
</turbo-stream>
