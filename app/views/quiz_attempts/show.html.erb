<% content_for(:title) { "#{@attempt.quiz.title} - Playing" } %>

<div class="max-w-4xl mx-auto" data-controller="quiz-player">
  <!-- Progress Bar -->
  <div class="mb-8 bg-white/10 rounded-2xl p-4 border-2 border-kahoot-purple-light/30">
    <div class="flex justify-between items-center mb-3">
      <span class="text-white font-bold">
        <span class="text-kahoot-yellow">Q<%= @progress[:answered] + 1 %></span> of <%= @progress[:total] %>
      </span>
      <span class="text-white font-black text-xl flex items-center gap-2" id="score-display">
        <span class="text-2xl">⭐</span> <%= @attempt.total_score %>
      </span>
    </div>
    <div class="bg-kahoot-purple-dark rounded-full h-4 overflow-hidden">
      <div class="bg-gradient-to-r from-kahoot-yellow to-kahoot-orange h-4 rounded-full transition-all duration-500 ease-out" style="width: <%= @progress[:percentage] %>%"></div>
    </div>
  </div>

  <turbo-frame id="question-frame">
    <% if @current_question %>
      <%= render "quiz_attempts/question", question: @current_question, attempt: @attempt %>
    <% else %>
      <div class="text-center py-16 bg-white/10 rounded-3xl border-2 border-kahoot-green animate-bounce-in">
        <div class="text-8xl mb-6">🎉</div>
        <h2 class="text-5xl font-black text-white mb-4">Quiz Complete!</h2>
        <p class="text-2xl text-white/80 mb-8">
          Your final score: <span class="text-kahoot-yellow font-black"><%= @attempt.total_score %></span>
        </p>
        <%= link_to results_quiz_attempt_path(@attempt), class: "kahoot-btn inline-flex items-center gap-3 bg-kahoot-green hover:bg-kahoot-green-light text-white px-10 py-5 rounded-2xl font-black text-xl shadow-2xl" do %>
          <span class="text-2xl">📊</span> See Results
        <% end %>
      </div>
    <% end %>
  </turbo-frame>
</div>
