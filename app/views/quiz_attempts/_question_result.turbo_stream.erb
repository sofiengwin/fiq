<div class="question-result text-center py-8">
  <!-- Result Icon -->
  <div class="mb-6">
    <% if response.correct? %>
      <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-green-500/20 border-4 border-green-500">
        <span class="text-5xl">✅</span>
      </div>
    <% else %>
      <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-red-500/20 border-4 border-red-500">
        <span class="text-5xl">❌</span>
      </div>
    <% end %>
  </div>

  <!-- Score Awarded -->
  <h2 class="text-4xl font-bold text-white mb-2">
    <% if response.correct? %>
      +<%= response.score_awarded %> points!
    <% else %>
      0 points
    <% end %>
  </h2>

  <!-- Streak Info -->
  <% if response.quiz_attempt.streak > 1 %>
    <p class="text-yellow-400 text-lg mb-4">
      🔥 <%= response.quiz_attempt.streak %> in a row!
    </p>
  <% end %>

  <!-- Correct Answers -->
  <div class="bg-white/10 rounded-xl p-6 mt-6 max-w-2xl mx-auto">
    <h3 class="text-lg font-medium text-purple-300 mb-4">Correct answer<%= response.question.answer_options.correct.count > 1 ? "s" : "" %>:</h3>
    <div class="flex flex-wrap justify-center gap-2">
      <% response.question.answer_options.correct.each do |answer| %>
        <span class="inline-block px-4 py-2 rounded-lg bg-green-600/50 text-green-200 font-medium">
          <%= answer_shape(answer.color) %> <%= answer.text %>
        </span>
      <% end %>
    </div>
    
    <% user_selected = response.selected_answers %>
    <% if user_selected.any? && !response.correct? %>
      <h3 class="text-lg font-medium text-purple-300 mt-6 mb-4">Your answer<%= user_selected.count > 1 ? "s" : "" %>:</h3>
      <div class="flex flex-wrap justify-center gap-2">
        <% user_selected.each do |answer| %>
          <span class="inline-block px-4 py-2 rounded-lg <%= answer.is_correct ? 'bg-green-600/50 text-green-200' : 'bg-red-600/50 text-red-200' %> font-medium">
            <%= answer_shape(answer.color) %> <%= answer.text %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Next Question Button -->
  <% if next_question %>
    <%= link_to quiz_attempt_path(response.quiz_attempt), data: { turbo_frame: "question-frame" }, class: "inline-block mt-8 bg-purple-600 hover:bg-purple-500 text-white px-12 py-4 rounded-xl font-bold text-xl transition" do %>
      Next Question →
    <% end %>
  <% else %>
    <%= link_to results_quiz_attempt_path(response.quiz_attempt), class: "inline-block mt-8 bg-green-600 hover:bg-green-500 text-white px-12 py-4 rounded-xl font-bold text-xl transition" do %>
      📊 See Results
    <% end %>
  <% end %>
</div>

