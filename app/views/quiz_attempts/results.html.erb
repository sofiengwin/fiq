<% content_for(:title) { "Results - #{@attempt.quiz.title}" } %>

<div class="max-w-4xl mx-auto">
  <!-- Final Score Card -->
  <div class="bg-white/10 border-2 border-kahoot-purple-light/40 rounded-3xl p-10 text-center mb-8 animate-bounce-in">
    <div class="text-6xl mb-4">🎉</div>
    <h1 class="text-5xl font-black text-white mb-6">Quiz Complete!</h1>
    
    <div class="inline-flex items-center justify-center w-48 h-48 rounded-full bg-gradient-to-br from-kahoot-yellow to-kahoot-orange mb-8 shadow-2xl animate-pulse-glow">
      <div class="text-center">
        <p class="text-6xl font-black text-white"><%= @results[:percentage] %>%</p>
      </div>
    </div>

    <p class="text-4xl font-black text-white mb-4">
      <span class="text-kahoot-yellow"><%= @results[:total_score] %></span> / <%= @results[:max_possible_score] %> points
    </p>
    
    <p class="text-xl text-white/70">
      <span class="text-kahoot-green font-bold"><%= @results[:responses].count { |r| r[:correct] } %></span> of <%= @results[:responses].count %> questions correct
    </p>
  </div>

  <!-- Question Breakdown -->
  <div class="bg-white/10 border-2 border-kahoot-purple-light/40 rounded-3xl p-8 mb-8">
    <h2 class="text-3xl font-black text-white mb-6 flex items-center gap-3">
      <span>📋</span> Question Breakdown
    </h2>
    
    <div class="space-y-4">
      <% @results[:responses].each_with_index do |result, index| %>
        <div class="flex items-center gap-4 p-5 rounded-2xl <%= result[:correct] ? 'bg-kahoot-green/20 border-2 border-kahoot-green' : 'bg-kahoot-red/20 border-2 border-kahoot-red' %>">
          <div class="flex-shrink-0">
            <% if result[:correct] %>
              <span class="text-4xl">✅</span>
            <% else %>
              <span class="text-4xl">❌</span>
            <% end %>
          </div>
          
          <div class="flex-1">
            <p class="text-white font-bold text-lg">
              <span class="text-kahoot-yellow"><%= index + 1 %>.</span> <%= result[:question].text %>
            </p>
            <div class="flex flex-wrap gap-2 mt-3">
              <% result[:selected_answers].each do |answer| %>
                <span class="text-sm px-3 py-1 rounded-full font-semibold <%= answer.is_correct ? 'bg-kahoot-green text-white' : 'bg-kahoot-red text-white' %>">
                  <%= answer.text %>
                </span>
              <% end %>
              <% if result[:selected_answers].empty? %>
                <span class="text-sm px-3 py-1 rounded-full bg-gray-600 text-white/70 font-semibold">No answer</span>
              <% end %>
            </div>
          </div>
          
          <div class="flex-shrink-0 text-right">
            <p class="text-2xl font-black <%= result[:correct] ? 'text-kahoot-green' : 'text-kahoot-red' %>">
              +<%= result[:score] %>
            </p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Actions -->
  <div class="flex flex-col sm:flex-row justify-center gap-4">
    <%= button_to quiz_attempts_path(quiz_id: @attempt.quiz.id), method: :post, class: "kahoot-btn bg-kahoot-blue hover:bg-kahoot-blue-light text-white px-10 py-5 rounded-2xl font-black text-xl shadow-2xl flex items-center justify-center gap-3" do %>
      <span class="text-2xl">🔄</span> Retake Quiz
    <% end %>
    <%= link_to quizzes_path, class: "kahoot-btn bg-kahoot-purple hover:bg-kahoot-purple-light text-white px-10 py-5 rounded-2xl font-black text-xl shadow-2xl flex items-center justify-center gap-3" do %>
      <span class="text-2xl">🔍</span> Browse Quizzes
    <% end %>
  </div>
</div>

