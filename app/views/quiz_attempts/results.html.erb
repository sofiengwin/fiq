<% content_for(:title) { "Results - #{@attempt.quiz.title}" } %>

<div class="max-w-4xl mx-auto">
  <!-- Final Score Card: score + count only, no breakdown -->
  <div class="bg-white/10 border border-purple-500/30 rounded-2xl p-8 text-center mb-8">
    <h1 class="text-4xl font-bold text-white mb-4">🎉 Quiz Complete!</h1>

    <p class="text-3xl font-bold text-white mb-2">
      <%= @results[:total_score] %> points
    </p>

    <p class="text-purple-300">
      <%= @results[:responses].count { |r| r[:correct] } %> of <%= @results[:responses].count %> correct
    </p>
  </div>

  <%# Q10: friend-vs-inviter comparison, invited attempts only. Side-by-side
      friend score/count + inviter best score/count with a winner callout
      (higher wins, score tie → faster wall-clock duration wins). When the
      inviter has never played there is no placeholder, no empty state, and
      no check-back copy — the friend score above stands alone. %>
  <% if @inviter_best %>
    <div class="bg-white/10 border border-purple-500/30 rounded-2xl p-8 text-center mb-8">
      <h2 class="text-2xl font-bold text-white mb-6">You vs Inviter</h2>

      <div class="grid grid-cols-2 gap-4 mb-6">
        <div class="bg-purple-800/50 rounded-xl p-4">
          <p class="text-purple-300 text-sm mb-1">Your score</p>
          <p class="text-3xl font-bold text-white"><%= @attempt.total_score %> points</p>
          <p class="text-purple-300">
            <%= @results[:responses].count { |r| r[:correct] } %> of <%= @results[:responses].count %> correct
          </p>
        </div>
        <div class="bg-purple-800/50 rounded-xl p-4">
          <p class="text-purple-300 text-sm mb-1">Inviter's best</p>
          <p class="text-3xl font-bold text-white"><%= @inviter_best.total_score %> points</p>
          <p class="text-purple-300">
            <%= @inviter_best_correct %> of <%= @inviter_best.responses.size %> correct
          </p>
        </div>
      </div>

      <% if @comparison_winner == :friend %>
        <p class="text-2xl font-bold text-green-400">🎉 You win!</p>
      <% elsif @comparison_winner == :inviter %>
        <p class="text-2xl font-bold text-yellow-300">🏆 Inviter wins!</p>
      <% else %>
        <p class="text-2xl font-bold text-white">🤝 It's a tie!</p>
      <% end %>
    </div>
  <% end %>

  <!-- Q11 share sheet + public leaderboard link. The share section (id
       anchors #share) renders only when signed-in and carries the SAME
       absolute invite link as Q9; guests see no send affordance. -->
  <% if @share_url %>
    <%= render "shared/share",
        share_url: @share_url,
        share_title: @attempt.quiz.title,
        share_text: "I scored #{@attempt.total_score} points — can you beat me?" %>
  <% end %>

  <div id="leaderboard" class="flex justify-center gap-4">
    <%= link_to leaderboard_quiz_path(@attempt.quiz), class: "bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-bold text-lg transition border border-white/20" do %>
      🏆 Leaderboard
    <% end %>
    <%= button_to quiz_attempts_path(quiz_id: @attempt.quiz.id), method: :post, class: "bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-bold text-lg transition border border-white/20" do %>
      🔄 Retake Quiz
    <% end %>
  </div>
</div>
