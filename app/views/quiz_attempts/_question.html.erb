<div class="quiz-question" data-controller="quiz-timer" data-quiz-timer-seconds-value="<%= question.effective_time_limit %>">
  <!-- Timer -->
  <div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-purple-800/50 border-4 border-purple-500">
      <span class="text-4xl font-bold text-white" data-quiz-timer-target="display">
        <%= question.effective_time_limit %>
      </span>
    </div>
  </div>

  <!-- Question Card -->
  <div class="bg-white/10 border border-purple-500/30 rounded-2xl p-8 mb-8">
    <% if question.image_url.present? %>
      <div class="mb-6">
        <%= image_tag question.image_url, class: "max-w-full h-64 object-contain mx-auto rounded-lg", alt: "Question image" %>
      </div>
    <% end %>
    
    <h2 class="text-2xl font-bold text-white text-center">
      <%= question.text %>
    </h2>
    
    <p class="text-purple-300 text-center mt-4">
      <span class="inline-block bg-purple-600/50 px-3 py-1 rounded-full text-sm">
        <%= question.points %> points
      </span>
      <% if question.answer_options.where(is_correct: true).count > 1 %>
        <span class="inline-block bg-blue-600/50 px-3 py-1 rounded-full text-sm ml-2">
          Select all that apply
        </span>
      <% end %>
    </p>
  </div>

  <!-- Answer Form -->
  <%= form_with url: quiz_attempt_responses_path(attempt), method: :post, 
                data: { 
                  turbo_frame: "question-frame",
                  quiz_timer_target: "form",
                  controller: "answer-selection"
                }, 
                class: "space-y-4" do |f| %>
    <%= f.hidden_field "response[question_id]", value: question.id %>
    <%= f.hidden_field "response[time_taken_ms]", value: 0, data: { quiz_timer_target: "timeTaken" } %>

    <!-- Answer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% question.answer_options.each do |answer| %>
        <label class="block cursor-pointer" data-answer-selection-target="option">
          <input type="checkbox" 
                 name="response[selected_answer_ids][]" 
                 value="<%= answer.id %>"
                 class="sr-only peer"
                 data-action="change->answer-selection#toggle">
          <div class="<%= answer_button_class(answer.color) %> peer-checked:ring-4 peer-checked:ring-white peer-checked:scale-105">
            <span class="mr-3 text-2xl"><%= answer_shape(answer.color) %></span>
            <%= answer.text %>
          </div>
        </label>
      <% end %>
    </div>

    <!-- Submit Button -->
    <div class="text-center pt-4">
      <%= f.submit "Submit Answer", 
                   class: "bg-green-600 hover:bg-green-500 disabled:bg-gray-600 disabled:cursor-not-allowed text-white px-12 py-4 rounded-xl font-bold text-xl transition",
                   data: { quiz_timer_target: "submit", action: "click->quiz-timer#submit" } %>
    </div>
  <% end %>
</div>
