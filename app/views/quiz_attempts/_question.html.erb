<div class="quiz-question animate-bounce-in" data-controller="quiz-timer" data-quiz-timer-seconds-value="<%= question.effective_time_limit %>">
  <!-- Timer -->
  <div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-28 h-28 rounded-full bg-kahoot-purple-dark border-4 border-kahoot-yellow animate-pulse-glow">
      <span class="text-5xl font-black text-white" data-quiz-timer-target="display">
        <%= question.effective_time_limit %>
      </span>
    </div>
  </div>

  <!-- Question Card -->
  <div class="bg-white/10 border-2 border-kahoot-purple-light/40 rounded-3xl p-8 mb-8 shadow-2xl">
    <% if question.image_url.present? %>
      <div class="mb-6">
        <%= image_tag question.image_url, class: "max-w-full h-64 object-contain mx-auto rounded-2xl", alt: "Question image" %>
      </div>
    <% end %>
    
    <h2 class="text-2xl md:text-3xl font-black text-white text-center leading-tight">
      <%= question.text %>
    </h2>
    
    <div class="flex justify-center gap-3 mt-6">
      <span class="inline-flex items-center gap-1 bg-kahoot-yellow/30 px-4 py-2 rounded-full text-white font-bold">
        <span class="text-xl">⭐</span> <%= question.points %> points
      </span>
      <% if question.answer_options.where(is_correct: true).count > 1 %>
        <span class="inline-flex items-center gap-1 bg-kahoot-blue/30 px-4 py-2 rounded-full text-white font-bold">
          <span class="text-xl">✌️</span> Select all that apply
        </span>
      <% end %>
    </div>
  </div>

  <!-- Answer Form -->
  <%= form_with url: quiz_attempt_responses_path(attempt), method: :post, 
                data: { 
                  turbo_frame: "question-frame",
                  quiz_timer_target: "form",
                  controller: "answer-selection"
                }, 
                class: "space-y-4" do |f| %>
    <%= f.hidden_field "response[question_id]", value: question.id %>
    <%= f.hidden_field "response[time_taken_ms]", value: 0, data: { quiz_timer_target: "timeTaken" } %>

    <!-- Answer Grid - Kahoot Style -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% question.answer_options.each do |answer| %>
        <label class="block cursor-pointer" data-answer-selection-target="option">
          <input type="checkbox" 
                 name="response[selected_answer_ids][]" 
                 value="<%= answer.id %>"
                 class="sr-only peer"
                 data-action="change->answer-selection#toggle">
          <div class="kahoot-answer <%= kahoot_answer_button_class(answer.color) %> peer-checked:ring-4 peer-checked:ring-white peer-checked:scale-105 peer-checked:shadow-2xl">
            <span class="text-4xl mr-4"><%= kahoot_answer_shape(answer.color) %></span>
            <span class="text-xl font-bold"><%= answer.text %></span>
          </div>
        </label>
      <% end %>
    </div>

    <!-- Submit Button -->
    <div class="text-center pt-6">
      <%= f.submit "Submit Answer", 
                   class: "kahoot-btn bg-white hover:bg-gray-100 text-kahoot-purple px-16 py-5 rounded-2xl font-black text-xl shadow-2xl cursor-pointer",
                   data: { quiz_timer_target: "submit", action: "click->quiz-timer#submit" } %>
    </div>
  <% end %>
</div>
