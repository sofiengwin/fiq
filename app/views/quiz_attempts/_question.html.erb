<%# Thin wrapper (Q3): Turbo-frame navigations to quiz_attempt_path render the %>
<%# same shared play screen as /play/question. All header/tile/quit DOM %>
<%# lives in shared/_play_screen. %>
<% progress = attempt.progress %>
<%= render "shared/play_screen",
      question: question,
      question_number: progress[:answered] + 1,
      total_questions: progress[:total],
      score: attempt.total_score,
      streak: attempt.streak,
      effective_limit: local_assigns.fetch(:effective_limit, question.effective_time_limit),
      form_url: quiz_attempt_responses_path(attempt),
      form_input_name: "response[selected_answer_ids][]",
      hidden_question_id: question.id,
      time_field_name: "response[time_taken_ms]",
      turbo_frame_name: "question-frame",
      quit_path: quizzes_path,
      quit_method: :get %>
