<%# frozen_string_literal: true %>
<%# Saved-attempt snap reveal (Q6). Same snap contract as the shared %>
<%# partial: correct tiles .is-correct, wrong picks .is-wrong-pick, +N/+0 %>
<%# near tiles, updated header score/streak, no interactivity, no Next %>
<%# button — snap-advance navigates to the next question (or results) on %>
<%# its own. Shown +N is the persisted response.score_awarded from the %>
<%# Q2 QuizScoring formula, never recomputed here. %>
<%
  question = response.question
  options = question.answer_options.order(:order_index).to_a
  correct_ids = options.select(&:is_correct?).map(&:id)
  picked_ids = response.selected_answer_ids.map(&:to_i)
  tiles = options.each_with_index.map do |opt, i|
    { id: opt.id, text: opt.text, image_url: opt.image_url,
      color: tile_color_for(i),
      correct: correct_ids.include?(opt.id),
      picked: picked_ids.include?(opt.id) }
  end
  total = response.quiz_attempt.quiz.questions.count
  answered = response.quiz_attempt.responses.count
  next_url = next_question ? quiz_attempt_path(response.quiz_attempt) : results_quiz_attempt_path(response.quiz_attempt)
%>
<%= render "shared/play_snap",
      tiles: tiles,
      points: response.score_awarded,
      score: response.quiz_attempt.total_score,
      streak: response.quiz_attempt.streak,
      question_number: answered,
      total_questions: total,
      next_url: next_url,
      frame: "question-frame" %>
