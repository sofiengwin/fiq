<% content_for(:title) { "FIQ - Fun Interactive Quizzes" } %>

<!-- Hero Section -->
<div class="text-center py-16">
  <h1 class="text-6xl font-bold text-white mb-6">
    🎮 Welcome to <span class="text-purple-300">FIQ</span>
  </h1>
  <p class="text-xl text-purple-200 mb-8 max-w-2xl mx-auto">
    Create and play fun, interactive quizzes! Challenge yourself or share with friends.
  </p>
  <div class="flex justify-center gap-4">
    <%= link_to new_quiz_path, class: "bg-purple-600 hover:bg-purple-500 text-white px-8 py-4 rounded-xl font-bold text-lg transition transform hover:scale-105" do %>
      ✨ Create a Quiz
    <% end %>
    <%= link_to quizzes_path, class: "bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-bold text-lg transition border border-white/20" do %>
      🔍 Browse Quizzes
    <% end %>
  </div>
</div>

<!-- Recent Quizzes -->
<% if @recent_quizzes.any? %>
  <div class="mt-16">
    <h2 class="text-3xl font-bold text-white mb-8 text-center">Recent Quizzes</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @recent_quizzes.each do |quiz| %>
        <%= render "quizzes/quiz_card", quiz: quiz %>
      <% end %>
    </div>
  </div>
<% end %>
