<% content_for(:title) { "FIQ - Fun Interactive Quizzes" } %>

<!-- Hero Section -->
<div class="text-center py-16 animate-bounce-in">
  <div class="mb-8">
    <span class="text-8xl">🎯</span>
  </div>
  <h1 class="text-6xl md:text-7xl font-black text-white mb-6 tracking-tight">
    Welcome to <span class="bg-gradient-to-r from-kahoot-yellow to-kahoot-orange bg-clip-text text-transparent">FIQ!</span>
  </h1>
  <p class="text-xl md:text-2xl text-white/80 mb-10 max-w-2xl mx-auto font-medium">
    Create epic quizzes, challenge your friends, and make learning unforgettable! 🚀
  </p>
  <div class="flex flex-col sm:flex-row justify-center gap-4">
    <%= link_to new_quiz_path, class: "kahoot-btn bg-kahoot-green hover:bg-kahoot-green-light text-white px-10 py-5 rounded-2xl font-black text-xl shadow-2xl inline-flex items-center justify-center gap-3" do %>
      <span class="text-2xl">✨</span> Create Quiz
    <% end %>
    <%= link_to quizzes_path, class: "kahoot-btn bg-kahoot-blue hover:bg-kahoot-blue-light text-white px-10 py-5 rounded-2xl font-black text-xl shadow-2xl inline-flex items-center justify-center gap-3" do %>
      <span class="text-2xl">🔍</span> Browse Quizzes
    <% end %>
  </div>
</div>

<!-- Features Section -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-16">
  <div class="bg-kahoot-red/20 border-2 border-kahoot-red rounded-3xl p-8 text-center transform hover:scale-105 transition-transform">
    <div class="text-5xl mb-4">🎮</div>
    <h3 class="text-2xl font-bold text-white mb-2">Play & Learn</h3>
    <p class="text-white/70">Make learning fun with interactive quizzes</p>
  </div>
  <div class="bg-kahoot-blue/20 border-2 border-kahoot-blue rounded-3xl p-8 text-center transform hover:scale-105 transition-transform">
    <div class="text-5xl mb-4">⚡</div>
    <h3 class="text-2xl font-bold text-white mb-2">Fast & Exciting</h3>
    <p class="text-white/70">Race against the clock for bonus points</p>
  </div>
  <div class="bg-kahoot-green/20 border-2 border-kahoot-green rounded-3xl p-8 text-center transform hover:scale-105 transition-transform">
    <div class="text-5xl mb-4">🏆</div>
    <h3 class="text-2xl font-bold text-white mb-2">Compete & Win</h3>
    <p class="text-white/70">Build streaks and climb the leaderboard</p>
  </div>
</div>

<!-- Recent Quizzes -->
<% if @recent_quizzes.any? %>
  <div class="mt-16">
    <h2 class="text-4xl font-black text-white mb-8 text-center">
      <span class="text-kahoot-yellow">🔥</span> Hot Quizzes
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @recent_quizzes.each do |quiz| %>
        <%= render "quizzes/quiz_card", quiz: quiz %>
      <% end %>
    </div>
  </div>
<% end %>
