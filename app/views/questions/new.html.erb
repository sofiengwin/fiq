<% content_for(:title) { "Add Question - #{@quiz.title}" } %>

<div class="max-w-4xl mx-auto">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-white">Add Question</h1>
    <%= link_to edit_quiz_path(@quiz), class: "text-purple-300 hover:text-white transition" do %>
      ← Back to Quiz
    <% end %>
  </div>
  
  <%= render "form", question: @question, quiz: @quiz %>
</div>
