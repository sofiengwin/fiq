<% content_for(:title) { "#{@quiz.title} - FIQ" } %>

<div class="max-w-4xl mx-auto">
  <div class="bg-white/10 border-2 border-kahoot-purple-light/40 rounded-3xl p-8 animate-bounce-in">
    <div class="flex justify-between items-start mb-6">
      <div>
        <h1 class="text-4xl font-black text-white mb-3"><%= @quiz.title %></h1>
        <% if @quiz.description.present? %>
          <p class="text-white/70 text-lg"><%= @quiz.description %></p>
        <% end %>
      </div>
      <div class="flex gap-2">
        <%= link_to edit_quiz_path(@quiz), class: "kahoot-btn bg-kahoot-blue hover:bg-kahoot-blue-light text-white px-4 py-2 rounded-xl font-bold" do %>
          ✏️ Edit
        <% end %>
        <%= button_to duplicate_quiz_path(@quiz), method: :post, class: "kahoot-btn bg-kahoot-purple hover:bg-kahoot-purple-light text-white px-4 py-2 rounded-xl font-bold" do %>
          📋 Copy
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-4 mb-8">
      <div class="bg-kahoot-red/30 border-2 border-kahoot-red rounded-2xl p-5 text-center">
        <p class="text-4xl font-black text-white"><%= @quiz.question_count %></p>
        <p class="text-white/80 text-sm font-semibold">Questions</p>
      </div>
      <div class="bg-kahoot-blue/30 border-2 border-kahoot-blue rounded-2xl p-5 text-center">
        <p class="text-4xl font-black text-white"><%= @quiz.time_limit_seconds %>s</p>
        <p class="text-white/80 text-sm font-semibold">Per Question</p>
      </div>
      <div class="bg-kahoot-yellow/30 border-2 border-kahoot-yellow rounded-2xl p-5 text-center">
        <p class="text-xl font-black text-white"><%= @quiz.scoring_mode.humanize %></p>
        <p class="text-white/80 text-sm font-semibold">Scoring</p>
      </div>
    </div>

    <% if @quiz.questions.any? %>
      <%= button_to quiz_attempts_path(quiz_id: @quiz.id), method: :post, class: "kahoot-btn w-full bg-kahoot-green hover:bg-kahoot-green-light text-white py-5 rounded-2xl font-black text-2xl shadow-2xl flex items-center justify-center gap-3" do %>
        <span class="text-3xl">🎮</span> Start Quiz!
      <% end %>
    <% else %>
      <div class="text-center py-8 bg-white/5 rounded-2xl border-2 border-dashed border-white/20">
        <p class="text-white/60 text-lg mb-4">This quiz has no questions yet.</p>
        <%= link_to edit_quiz_path(@quiz), class: "text-kahoot-yellow hover:text-kahoot-orange font-bold underline" do %>
          ➕ Add Questions
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Questions Preview -->
  <% if @quiz.questions.any? %>
    <div class="mt-8">
      <h2 class="text-2xl font-black text-white mb-4 flex items-center gap-2">
        <span>📋</span> Questions Preview
      </h2>
      <div class="space-y-3">
        <% @quiz.questions.each_with_index do |question, index| %>
          <div class="bg-white/5 border border-kahoot-purple-light/30 rounded-2xl p-5 hover:bg-white/10 transition">
            <p class="text-white font-bold">
              <span class="text-kahoot-yellow"><%= index + 1 %>.</span> <%= question.text %>
            </p>
            <div class="flex gap-3 mt-3 text-sm">
              <span class="bg-kahoot-blue/30 text-white/80 px-3 py-1 rounded-full">
                <%= pluralize(question.answer_options.count, "answer") %>
              </span>
              <span class="bg-kahoot-green/30 text-white/80 px-3 py-1 rounded-full">
                <%= pluralize(question.answer_options.where(is_correct: true).count, "correct") %>
              </span>
              <span class="bg-kahoot-yellow/30 text-white/80 px-3 py-1 rounded-full">
                <%= question.points %> pts
              </span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
