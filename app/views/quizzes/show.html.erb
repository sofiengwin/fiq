<% content_for(:title) { "#{@quiz.title} - FIQ" } %>

<div class="max-w-4xl mx-auto">
  <div class="bg-white/10 border border-purple-500/30 rounded-2xl p-8">
    <div class="flex justify-between items-start mb-6">
      <div>
        <h1 class="text-4xl font-bold text-white mb-2"><%= @quiz.title %></h1>
        <% if @quiz.description.present? %>
          <p class="text-purple-200 text-lg"><%= @quiz.description %></p>
        <% end %>
      </div>
      <div class="flex gap-2">
        <%= link_to edit_quiz_path(@quiz), class: "bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-lg transition" do %>
          ✏️ Edit
        <% end %>
        <%= button_to duplicate_quiz_path(@quiz), method: :post, class: "bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-lg transition" do %>
          📋 Duplicate
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-6 mb-8">
      <div class="bg-purple-800/50 rounded-xl p-4 text-center">
        <p class="text-3xl font-bold text-white"><%= @quiz.question_count %></p>
        <p class="text-purple-300 text-sm">Questions</p>
      </div>
      <div class="bg-purple-800/50 rounded-xl p-4 text-center">
        <p class="text-3xl font-bold text-white"><%= @quiz.time_limit_seconds %>s</p>
        <p class="text-purple-300 text-sm">Per Question</p>
      </div>
      <div class="bg-purple-800/50 rounded-xl p-4 text-center">
        <p class="text-3xl font-bold text-white"><%= @quiz.scoring_mode.humanize %></p>
        <p class="text-purple-300 text-sm">Scoring Mode</p>
      </div>
    </div>

    <% if @quiz.questions.any? %>
      <%= button_to quiz_attempts_path(quiz_id: @quiz.id), method: :post, class: "w-full bg-green-600 hover:bg-green-500 text-white py-4 rounded-xl font-bold text-xl transition transform hover:scale-[1.02]" do %>
        🎮 Start Quiz!
      <% end %>
    <% else %>
      <div class="text-center py-8">
        <p class="text-purple-300 mb-4">This quiz has no questions yet.</p>
        <%= link_to "Add Questions", edit_quiz_path(@quiz), class: "text-purple-400 hover:text-purple-300 underline" %>
      </div>
    <% end %>
  </div>

  <!-- Questions Preview -->
  <% if @quiz.questions.any? %>
    <div class="mt-8">
      <h2 class="text-2xl font-bold text-white mb-4">Questions Preview</h2>
      <div class="space-y-4">
        <% @quiz.questions.each_with_index do |question, index| %>
          <div class="bg-white/5 border border-purple-500/20 rounded-lg p-4">
            <p class="text-white font-medium">
              <%= index + 1 %>. <%= question.text %>
            </p>
            <p class="text-purple-300 text-sm mt-1">
              <%= pluralize(question.answer_options.count, "answer") %> •
              <%= pluralize(question.answer_options.where(is_correct: true).count, "correct") %> •
              <%= question.points %> points
            </p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
