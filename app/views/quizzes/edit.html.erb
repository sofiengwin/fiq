<% content_for(:title) { "Edit #{@quiz.title} - FIQ" } %>

<div class="max-w-4xl mx-auto">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
    <h1 class="text-4xl font-black text-white flex items-center gap-3">
      <span class="text-4xl">✏️</span> Edit Quiz
    </h1>
    <%= link_to @quiz, class: "text-kahoot-yellow hover:text-white font-bold transition flex items-center gap-2" do %>
      <span>←</span> Back to Quiz
    <% end %>
  </div>
  
  <%= render "form", quiz: @quiz %>

  <!-- Existing Questions -->
  <% if @quiz.persisted? && @quiz.questions.any? %>
    <div class="mt-12">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-black text-white flex items-center gap-2">
          <span>📝</span> Questions
        </h2>
        <%= link_to new_quiz_question_path(@quiz), class: "kahoot-btn bg-kahoot-green hover:bg-kahoot-green-light text-white px-5 py-3 rounded-xl font-bold shadow-lg flex items-center gap-2" do %>
          <span>➕</span> Add Question
        <% end %>
      </div>
      
      <div class="space-y-4" data-controller="sortable">
        <% @quiz.questions.each_with_index do |question, index| %>
          <div class="bg-white/10 border-2 border-kahoot-purple-light/30 rounded-2xl p-5 hover:bg-white/15 transition">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <p class="text-white font-bold text-lg">
                  <span class="text-kahoot-yellow"><%= index + 1 %>.</span> <%= question.text %>
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <% question.answer_options.each do |answer| %>
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg text-sm font-semibold <%= answer.is_correct ? 'bg-kahoot-green text-white' : 'bg-white/10 text-white/70' %>">
                      <%= answer.text %> <%= "✓" if answer.is_correct %>
                    </span>
                  <% end %>
                </div>
                <div class="flex gap-3 mt-3">
                  <span class="text-sm bg-kahoot-yellow/30 text-white/80 px-3 py-1 rounded-full">
                    <%= question.points %> pts
                  </span>
                  <span class="text-sm bg-kahoot-blue/30 text-white/80 px-3 py-1 rounded-full">
                    <%= question.effective_time_limit %>s
                  </span>
                </div>
              </div>
              <div class="flex gap-3 ml-4">
                <%= link_to edit_quiz_question_path(@quiz, question), class: "kahoot-btn bg-kahoot-blue hover:bg-kahoot-blue-light text-white px-3 py-2 rounded-xl" do %>
                  ✏️
                <% end %>
                <%= button_to quiz_question_path(@quiz, question), method: :delete, data: { turbo_confirm: "Delete this question?" }, class: "kahoot-btn bg-kahoot-red hover:bg-kahoot-red-light text-white px-3 py-2 rounded-xl" do %>
                  🗑️
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% elsif @quiz.persisted? %>
    <div class="mt-12 text-center py-12 bg-white/5 rounded-3xl border-2 border-dashed border-white/20">
      <div class="text-5xl mb-4">📝</div>
      <p class="text-white/60 text-lg mb-4">No questions yet.</p>
      <%= link_to new_quiz_question_path(@quiz), class: "kahoot-btn inline-flex items-center gap-2 bg-kahoot-green hover:bg-kahoot-green-light text-white px-6 py-3 rounded-xl font-bold shadow-lg" do %>
        <span>➕</span> Add your first question
      <% end %>
    </div>
  <% end %>

  <!-- Danger Zone -->
  <% if @quiz.persisted? %>
    <div class="mt-12 bg-kahoot-red/10 border-2 border-kahoot-red/50 rounded-3xl p-8">
      <h3 class="text-2xl font-black text-kahoot-red mb-4 flex items-center gap-2">
        <span>⚠️</span> Danger Zone
      </h3>
      <%= button_to quiz_path(@quiz), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this quiz? This cannot be undone." }, class: "kahoot-btn bg-kahoot-red hover:bg-kahoot-red-light text-white px-6 py-3 rounded-xl font-bold shadow-lg" do %>
        🗑️ Delete Quiz
      <% end %>
    </div>
  <% end %>
</div>
