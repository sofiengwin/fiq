<% content_for(:title) { "Edit #{@quiz.title} - FIQ" } %>

<div class="max-w-4xl mx-auto">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-white">Edit Quiz</h1>
    <%= link_to @quiz, class: "text-purple-300 hover:text-white transition" do %>
      ← Back to Quiz
    <% end %>
  </div>
  
  <%= render "form", quiz: @quiz %>

  <!-- Existing Questions -->
  <% if @quiz.persisted? && @quiz.questions.any? %>
    <div class="mt-12">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-white">Questions</h2>
        <%= link_to new_quiz_question_path(@quiz), class: "bg-purple-600 hover:bg-purple-500 text-white px-4 py-2 rounded-lg font-medium transition" do %>
          ➕ Add Question
        <% end %>
      </div>
      
      <div class="space-y-4" data-controller="sortable">
        <% @quiz.questions.each_with_index do |question, index| %>
          <div class="bg-white/10 border border-purple-500/30 rounded-lg p-4">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <p class="text-white font-medium">
                  <span class="text-purple-400"><%= index + 1 %>.</span> <%= question.text %>
                </p>
                <div class="mt-2 flex flex-wrap gap-2">
                  <% question.answer_options.each do |answer| %>
                    <span class="inline-block px-2 py-1 rounded text-sm <%= answer.is_correct ? 'bg-green-600/50 text-green-200' : 'bg-white/10 text-purple-300' %>">
                      <%= answer.text %> <%= "✓" if answer.is_correct %>
                    </span>
                  <% end %>
                </div>
                <p class="text-purple-400 text-sm mt-2">
                  <%= question.points %> points • <%= question.effective_time_limit %>s
                </p>
              </div>
              <div class="flex gap-2 ml-4">
                <%= link_to edit_quiz_question_path(@quiz, question), class: "text-purple-300 hover:text-white" do %>
                  ✏️
                <% end %>
                <%= button_to quiz_question_path(@quiz, question), method: :delete, data: { turbo_confirm: "Delete this question?" }, class: "text-red-400 hover:text-red-300" do %>
                  🗑️
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% elsif @quiz.persisted? %>
    <div class="mt-12 text-center py-8 bg-white/5 rounded-xl border border-purple-500/20">
      <p class="text-purple-300 mb-4">No questions yet.</p>
      <%= link_to new_quiz_question_path(@quiz), class: "text-purple-400 hover:text-purple-300 underline" do %>
        Add your first question
      <% end %>
    </div>
  <% end %>

  <!-- Danger Zone -->
  <% if @quiz.persisted? %>
    <div class="mt-12 bg-red-900/20 border border-red-500/30 rounded-xl p-6">
      <h3 class="text-xl font-bold text-red-300 mb-4">Danger Zone</h3>
      <%= button_to quiz_path(@quiz), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this quiz? This cannot be undone." }, class: "bg-red-600 hover:bg-red-500 text-white px-4 py-2 rounded-lg font-medium transition" do %>
        🗑️ Delete Quiz
      <% end %>
    </div>
  <% end %>
</div>
