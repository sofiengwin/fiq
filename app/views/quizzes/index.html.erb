<% content_for(:title) { "All Quizzes - FIQ" } %>

<div class="max-w-6xl mx-auto">
  <div class="flex flex-col sm:flex-row justify-between items-center mb-8 gap-4">
    <h1 class="text-4xl font-black text-white flex items-center gap-3">
      <span>🎯</span> Browse Quizzes
    </h1>
    <%= link_to new_quiz_path, class: "kahoot-btn bg-kahoot-green hover:bg-kahoot-green-light text-white px-6 py-3 rounded-xl font-bold shadow-lg flex items-center gap-2" do %>
      <span class="text-xl">➕</span> Create New
    <% end %>
  </div>

  <!-- Search -->
  <div class="mb-8">
    <%= form_with url: quizzes_path, method: :get, class: "flex gap-3", data: { turbo_frame: "quizzes" } do |f| %>
      <%= f.text_field :search, value: params[:search], placeholder: "Search quizzes...", class: "flex-1 bg-white/10 border-2 border-kahoot-purple-light/40 rounded-xl px-5 py-4 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-kahoot-yellow focus:border-kahoot-yellow font-medium" %>
      <%= f.submit "Search", class: "kahoot-btn bg-kahoot-blue hover:bg-kahoot-blue-light text-white px-8 py-4 rounded-xl font-bold cursor-pointer" %>
    <% end %>
  </div>

  <turbo-frame id="quizzes">
    <% if @quizzes.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @quizzes.each do |quiz| %>
          <%= render "quiz_card", quiz: quiz %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-20 bg-white/5 rounded-3xl border-2 border-dashed border-white/20">
        <div class="text-6xl mb-4">🔍</div>
        <p class="text-white/70 text-xl mb-6">No quizzes found.</p>
        <%= link_to new_quiz_path, class: "kahoot-btn inline-flex items-center gap-2 bg-kahoot-green hover:bg-kahoot-green-light text-white px-8 py-4 rounded-xl font-bold shadow-lg" do %>
          <span class="text-xl">✨</span> Create the first one!
        <% end %>
      </div>
    <% end %>
  </turbo-frame>
</div>
