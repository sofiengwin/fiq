<% content_for(:title) { "All Quizzes - FIQ" } %>

<div class="max-w-6xl mx-auto">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-white">Browse Quizzes</h1>
    <%= link_to new_quiz_path, class: "bg-purple-600 hover:bg-purple-500 text-white px-6 py-3 rounded-lg font-medium transition" do %>
      ➕ Create New Quiz
    <% end %>
  </div>

  <!-- Search -->
  <div class="mb-8">
    <%= form_with url: quizzes_path, method: :get, class: "flex gap-4", data: { turbo_frame: "quizzes" } do |f| %>
      <%= f.text_field :search, value: params[:search], placeholder: "Search quizzes...", class: "flex-1 bg-white/10 border border-purple-500/30 rounded-lg px-4 py-3 text-white placeholder-purple-300 focus:outline-none focus:ring-2 focus:ring-purple-500" %>
      <%= f.submit "Search", class: "bg-purple-600 hover:bg-purple-500 text-white px-6 py-3 rounded-lg font-medium transition cursor-pointer" %>
    <% end %>
  </div>

  <turbo-frame id="quizzes">
    <% if @quizzes.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @quizzes.each do |quiz| %>
          <%= render "quiz_card", quiz: quiz %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16">
        <p class="text-purple-300 text-xl mb-4">No quizzes found.</p>
        <%= link_to "Create the first one!", new_quiz_path, class: "text-purple-400 hover:text-purple-300 underline" %>
      </div>
    <% end %>
  </turbo-frame>
</div>
