<%= form_with model: quiz, class: "space-y-6" do |f| %>
  <% if quiz.errors.any? %>
    <div class="bg-red-500/20 border border-red-500/50 rounded-lg p-4">
      <h3 class="text-red-200 font-medium mb-2">Please fix the following errors:</h3>
      <ul class="list-disc list-inside text-red-300 text-sm">
        <% quiz.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white/10 border border-purple-500/30 rounded-xl p-6 space-y-6">
    <div>
      <%= f.label :title, class: "block text-purple-200 font-medium mb-2" %>
      <%= f.text_field :title, class: "w-full bg-white/10 border border-purple-500/30 rounded-lg px-4 py-3 text-white placeholder-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-500", placeholder: "Enter quiz title..." %>
    </div>

    <div>
      <%= f.label :description, class: "block text-purple-200 font-medium mb-2" %>
      <%= f.text_area :description, rows: 3, class: "w-full bg-white/10 border border-purple-500/30 rounded-lg px-4 py-3 text-white placeholder-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-500", placeholder: "Optional description..." %>
    </div>

    <div class="grid grid-cols-2 gap-6">
      <div>
        <%= f.label :time_limit_seconds, "Time per question (seconds)", class: "block text-purple-200 font-medium mb-2" %>
        <%= f.number_field :time_limit_seconds, min: 5, max: 120, class: "w-full bg-white/10 border border-purple-500/30 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-purple-500" %>
      </div>

      <div>
        <%= f.label :scoring_mode, class: "block text-purple-200 font-medium mb-2" %>
        <%= f.select :scoring_mode, [["Partial Credit", "partial_credit"], ["All or Nothing", "all_or_nothing"]], {}, class: "w-full bg-white/10 border border-purple-500/30 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-purple-500" %>
      </div>
    </div>
  </div>

  <div class="flex justify-end gap-4">
    <%= link_to "Cancel", quiz.persisted? ? quiz_path(quiz) : quizzes_path, class: "bg-white/10 hover:bg-white/20 text-white px-6 py-3 rounded-lg font-medium transition" %>
    <%= f.submit quiz.persisted? ? "Update Quiz" : "Create Quiz", class: "bg-purple-600 hover:bg-purple-500 text-white px-6 py-3 rounded-lg font-medium transition cursor-pointer" %>
  </div>
<% end %>
