<%= link_to quiz_path(quiz), class: "group block bg-white/10 hover:bg-white/20 border-2 border-kahoot-purple-light/40 hover:border-kahoot-yellow rounded-3xl p-6 transition-all duration-300 transform hover:scale-[1.03] hover:shadow-2xl" do %>
  <div class="flex items-start justify-between mb-3">
    <h3 class="text-xl font-bold text-white group-hover:text-kahoot-yellow transition-colors"><%= quiz.title %></h3>
    <span class="text-2xl">🎯</span>
  </div>
  <% if quiz.description.present? %>
    <p class="text-white/70 text-sm mb-4 line-clamp-2"><%= quiz.description %></p>
  <% end %>
  <div class="flex items-center gap-4 text-sm text-white/60 mb-4">
    <span class="flex items-center gap-1">
      <span class="text-kahoot-blue">📝</span> <%= pluralize(quiz.question_count, "question") %>
    </span>
    <span class="flex items-center gap-1">
      <span class="text-kahoot-red">⏱️</span> <%= quiz.time_limit_seconds %>s
    </span>
  </div>
  <div class="flex gap-2">
    <span class="inline-block bg-kahoot-purple text-white text-xs px-3 py-1 rounded-full font-semibold">
      <%= quiz.scoring_mode.humanize %>
    </span>
  </div>
  <div class="mt-4 pt-4 border-t border-white/10">
    <span class="text-kahoot-green font-bold group-hover:text-white transition-colors">Play Now →</span>
  </div>
<% end %>
