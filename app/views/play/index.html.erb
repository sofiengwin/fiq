<% content_for(:title) { "Quick Play - FIQ" } %>

<div class="max-w-4xl mx-auto">
  <div class="text-center mb-12">
    <h1 class="text-5xl font-bold text-white mb-4">Quick Play</h1>
    <p class="text-purple-200 text-xl">Test your football knowledge with dynamically generated questions!</p>
  </div>

  <%= form_with url: start_play_path, method: :post, class: "space-y-8" do |f| %>
    <!-- Quiz Type Selection -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @quiz_types.each do |quiz_type| %>
        <label class="block cursor-pointer">
          <input type="radio" 
                 name="quiz_type" 
                 value="<%= quiz_type[:key] %>"
                 <%= "checked" if quiz_type[:recommended] %>
                 class="sr-only peer">
          <div class="h-full bg-white/10 hover:bg-white/15 border-2 border-purple-500/30 peer-checked:border-purple-400 peer-checked:bg-purple-600/30 rounded-xl p-6 transition">
            <div class="text-4xl mb-3"><%= quiz_type[:icon] %></div>
            <h3 class="text-xl font-bold text-white mb-2">
              <%= quiz_type[:name] %>
              <% if quiz_type[:recommended] %>
                <span class="text-xs bg-yellow-500 text-yellow-900 px-2 py-0.5 rounded-full ml-2">Recommended</span>
              <% end %>
            </h3>
            <p class="text-purple-300 text-sm"><%= quiz_type[:description] %></p>
          </div>
        </label>
      <% end %>
    </div>

    <!-- Question Count -->
    <div class="bg-white/10 border border-purple-500/30 rounded-xl p-6">
      <h3 class="text-xl font-bold text-white mb-4">How many questions?</h3>
      <div class="flex flex-wrap gap-4">
        <% [5, 10, 15, 20].each do |count| %>
          <label class="cursor-pointer">
            <input type="radio" 
                   name="question_count" 
                   value="<%= count %>"
                   <%= "checked" if count == 10 %>
                   class="sr-only peer">
            <div class="px-8 py-4 bg-purple-700/50 hover:bg-purple-600/50 peer-checked:bg-purple-500 peer-checked:ring-2 peer-checked:ring-white rounded-lg text-white font-bold text-xl transition">
              <%= count %>
            </div>
          </label>
        <% end %>
      </div>
    </div>

    <!-- Start Button -->
    <div class="text-center">
      <%= f.submit "Start Quiz", class: "bg-green-600 hover:bg-green-500 text-white px-16 py-5 rounded-xl font-bold text-2xl transition transform hover:scale-105 cursor-pointer" %>
    </div>
  <% end %>

  <!-- Back to quizzes link -->
  <div class="text-center mt-8">
    <%= link_to "← Back to saved quizzes", quizzes_path, class: "text-purple-300 hover:text-purple-200 transition" %>
  </div>
</div>
