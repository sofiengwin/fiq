<% content_for(:title) { "Playing - FIQ" } %>

<div class="max-w-4xl mx-auto">
  <%= render "shared/play_screen",
        question: @question,
        question_number: @progress[:current],
        total_questions: @progress[:total],
        score: @progress[:score],
        streak: @progress[:streak],
        effective_limit: @effective_limit,
        form_url: play_answer_path,
        form_input_name: "selected_ids[]",
        time_field_name: "time_taken_ms",
        hidden_question_index: @play_session.current_index,
        quit_path: quit_play_path,
        quit_method: :delete %>
</div>
